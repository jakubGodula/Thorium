        .entropy-cell.active {
            background: rgba(16, 185, 129, 0.1);
            border-color: var(--success);
            color: var(--success);
            text-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
        }
    </style>
</head>
<body>
    <div class='container'>
        <div class='header'>
            <div class='logo-section'>
                <div class='logo-icon'>🪙</div>
