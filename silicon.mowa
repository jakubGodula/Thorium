            overflow-y: auto;
        }
        .terminal-line {
            margin-bottom: 8px;
            line-height: 1.5;
        }
        .terminal-time {
            color: var(--text-secondary);
        }
        .terminal-success {
            color: var(--success);
        }
        .terminal-warning {
            color: var(--accent-glow);
        }
        .btn {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            border: none;
            color: white;
            padding: 12px 20px;
            font-size: 14px;
