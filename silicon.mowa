            </div>
            <div class='status-badge'>
                <div class='status-dot'></div>
                Simulated Online
            </div>
        </div>

        <div class='grid'>
            <div class='card'>
                <h2>Metadane Systemu</h2>
                <div class='metric'>
                    <div class='metric-label'>Uptime</div>
                    <div class='metric-value'>" + tekst(uptime_sec) + " s</div>
                </div>
                <div class='metric'>
                    <div class='metric-label'>Obsłużone Zapytania</div>
                    <div class='metric-value'>" + tekst(request_counter) + "</div>
                </div>
                <div class='metric'>
                    <div class='metric-label'>Portfel Simulatora (Ed25519)</div>
                    <div class='metric-value' style='font-size: 11px;'>" + pub_key + "</div>
                </div>
                <div class='metric'>
                    <div class='metric-label'>Standard Kryptografii</div>
                    <div class='metric-value'>Ed25519 + PQC Salt</div>
                </div>
            </div>

            <div class='card'>
                <h2>Kwantowy Generator Entropii</h2>
                <div class='metric-label' style='font-size: 12px;'>Bieżący stan losowości z 8 bramkowych Kubitów Hadamarda:</div>
                <div class='entropy-visualizer'>
                    <div class='entropy-cell active'>|Ψ₀⟩</div>
                    <div class='entropy-cell active'>|Ψ₁⟩</div>
                    <div class='entropy-cell active'>|Ψ₂⟩</div>
                    <div class='entropy-cell active'>|Ψ₃⟩</div>
                    <div class='entropy-cell active'>|Ψ₄⟩</div>
                    <div class='entropy-cell active'>|Ψ₅⟩</div>
                    <div class='entropy-cell active'>|Ψ₆⟩</div>
                    <div class='entropy-cell active'>|Ψ₇⟩</div>
                </div>
                <div style='margin-top: 15px;'>
                    <a href='#' onclick='window.location.reload();' class='btn' style='width: 100%; box-sizing: border-box; text-decoration: none;'>Regeneruj PQC Salt</a>
                </div>
            </div>
        </div>

        <div class='card'>
            <h2>Dziennik Weryfikacji (Telemetry Log)</h2>
            <div class='terminal'>
                <div class='terminal-line'>
                    <span class='terminal-time'>[System Boot]</span> Symulator Silicon wystartował pomyślnie na porcie 9191.
                </div>
                <div class='terminal-line'>
                    <span class='terminal-time'>[Hardware Ready]</span> Wszystkie interfejsy wirtualne (USB-HID, NFC, Sui Move Smart Contracts) gotowe.
                </div>
                <div class='terminal-line'>
                    <span class='terminal-time'>[Ostatnie zdarzenie]</span> <span class='terminal-success'>" + last_request_log + "</span>
                </div>
            </div>
        </div>
    </div>
</body>
</html>";
    zwróć html;
}

funkcja router_silicon(sciezka, zapytanie, metoda) {
    pisz("📥 [Silicon API] Żądanie:", metoda, sciezka);
    
    jeśli (sciezka == "/" lub sciezka == "/index.html" lub sciezka == "/status") {
        niech html = get_dashboard_html();
        
        niech odpowiedz = slownik();
        odpowiedz = ustaw(odpowiedz, "kod", 200);
        odpowiedz = ustaw(odpowiedz, "typ", "text/html; charset=utf-8");
        odpowiedz = ustaw(odpowiedz, "tresc", html);
        zwróć odpowiedz;
    }
    
    jeśli (sciezka == "/api/sign" i metoda == "POST") {
        request_counter = request_counter + 1;
        
        niech key_type = json_pobierz(zapytanie, "hardwareKeyType");
        niech region = json_pobierz(zapytanie, "region");
        niech country = json_pobierz(zapytanie, "country");
        niech challenge = json_pobierz(zapytanie, "challenge");
        
        pisz("🔑 [Silicon Sign] Żądanie podpisania challenge'u:");
        pisz("  - Key Type:", key_type);
        pisz("  - Region:", region);
        pisz("  - Country:", country);
        pisz("  - Challenge:", challenge);
        
        // Generujemy PQC Salt za pomocą wbudowanego symulatora kwantowego Mowa!
        niech pqc_salt = generuj_quantum_salt();
        pisz("  - Wygenerowany Post-Quantum Salt:", pqc_salt);
        
        // Tworzymy kryptograficzny podpis za pomocą klucza prywatnego Ed25519
        niech wiadomosc = bcs_koduj(challenge + pqc_salt);
        niech podpis = krypto_podpisz(priv_key, wiadomosc);
        
        // Konwertujemy podpis bajtowy na format tekstowy hex
        niech podpis_hex = hash(challenge + pqc_salt, "sha256"); // hash returns hex string!
        
        // Zbudowanie detali urządzenia w zależności od regionu i typu klucza
        niech device_name = "Generic FIDO2 USB Security Key";
        niech cert_info = "WebAuthn Level 2 Authenticator";
        niech standard_info = "CTAP2 / USB-HID";
        niech serial_num = "GEN-" + tekst(1000000 + request_counter);
        niech issuer_info = "FIDO Alliance Certified";
        
        jeśli (key_type == "yubikey_fips") {
            device_name = "YubiKey 5 NFC FIPS (Serial: 14890274)";
            cert_info = "FIPS 140-2 Level 2 Approved (AAGUID: 2fc05b9e-c533-4de7-91a5-e179e8ff5f92)";
            standard_info = "FIDO2 / PIV (Military Grade)";
            serial_num = "FIPS-14890274";
            issuer_info = "Yubico AB";
        }
        
        jeśli (key_type == "yubikey") {
            device_name = "YubiKey 5C Nano (Serial: 09874123)";
            cert_info = "Standard FIDO2 / U2F (AAGUID: cb407fa2-1698-4c8e-a9ff-523194a0815c)";
            standard_info = "FIDO2 / WebAuthn";
            serial_num = "YUBI-09874123";
            issuer_info = "Yubico AB";
        }
        
        jeśli (key_type == "ledger") {
            device_name = "Ledger Nano X (Hardware Wallet)";
            cert_info = "Sui Ledger BIP-32 Protocol (m/44'/784'/0'/0'/0')";
            standard_info = "Sui Wallet Integration";
            serial_num = "LDGR-NANOX-9982";
            issuer_info = "Ledger SAS";
        }
        
        jeśli (key_type == "eid") {
            standard_info = "ICAO Doc 9303 / ISO-7816 CAN";
            serial_num = "CAN-" + pqc_salt;
            
            jeśli (region == "US") {
                device_name = "US Passport Card / National ID (NFC RFID Chip)";
                cert_info = "Biometric Identity Certificate (US Dept of State CSCA)";
                standard_info = "ICAO Doc 9303 / Federal PIV-I";
                issuer_info = "United States of America (Department of State)";
            }
            jeśli (region == "CA") {
                device_name = "Canadian Biometric Passport (NFC RFID Chip)";
                cert_info = "ePassport PKI Authentication (Government of Canada CSCA)";
                standard_info = "ICAO Doc 9303 / Passive Auth";
                issuer_info = "Canada (Gouvernement du Canada)";
            }
            jeśli (region == "UK") {
                device_name = "UK Biometric Passport (NFC RFID Chip)";
                cert_info = "HMPO Certificate Authority (HM Passport Office CSCA)";
                standard_info = "ICAO Doc 9303 / Active Auth";
                issuer_info = "United Kingdom (HM Passport Office)";
            }
            jeśli (region == "CH") {
                device_name = "Schweizer Identitätskarte / Pass (NFC RFID Chip)";
                cert_info = "fedpol SwissID Certificate (Bundesamt für Polizei CSCA)";
                standard_info = "ICAO Doc 9303 / SwissID";
                issuer_info = "Schweizerische Eidgenossenschaft (fedpol)";
            }
            jeśli (region == "NO") {
                device_name = "Norsk Nasjonalt ID-kort / Pass (NFC RFID Chip)";
                cert_info = "Nasjonalt ID-kort Signatursertifikat (Politidirektoratet CSCA)";
                standard_info = "ICAO Doc 9303 / BankID NFC";
                issuer_info = "Kongeriket Norge (Politiet)";
            }
            jeśli (region == "IS") {
                device_name = "Íslenskt Nafnuskírteini / Vegabréf (NFC RFID Chip)";
                cert_info = "Þjóðskrá Íslands CSCA (Registers Iceland CSCA)";
                standard_info = "ICAO Doc 9303 / Kennitala Auth";
                issuer_info = "Lýðveldið Ísland (Þjóðskrá Íslands)";
            }
            jeśli (region == "EU") {
                niech native_country = country;
                niech issuer = "EU Member State CSCA Authority (" + country + ")";
                
                jeśli (country == "PL") {
                    native_country = "Polska 🇵🇱";
                    issuer = "Ministerstwo Cyfryzacji Rzeczypospolitej Polskiej CSCA";
                }
                jeśli (country == "DE") {
                    native_country = "Deutschland 🇩🇪";
                    issuer = "Bundesamt für Sicherheit in der Informationstechnik CSCA";
                }
                jeśli (country == "FR") {
                    native_country = "France 🇫🇷";
                    issuer = "Agence Nationale des Titres Sécurisés CSCA";
                }
                jeśli (country == "IT") {
                    native_country = "Italia 🇮🇹";
                    issuer = "Ministero dell'Interno CSCA";
                }
                jeśli (country == "ES") {
                    native_country = "España 🇪🇸";
                    issuer = "Dirección General de la Policía CSCA";
                }
                jeśli (country == "NL") {
                    native_country = "Nederland 🇳🇱";
                    issuer = "Rijksdienst voor Identiteitsgegevens CSCA";
                }
                jeśli (country == "BE") {
                    native_country = "Belgique/België 🇧🇪";
                    issuer = "Service Public Fédellar Intérieur CSCA";
                }
                jeśli (country == "AT") {
                    native_country = "Österreich 🇦🇹";
                    issuer = "Bundesministerium für Inneres CSCA";
                }
                jeśli (country == "SE") {
                    native_country = "Sverige 🇸🇪";
                    issuer = "Polismyndigheten CSCA";
                }
                jeśli (country == "DK") {
                    native_country = "Danmark 🇩🇰";
                    issuer = "Rigspolitiet CSCA";
                }
                jeśli (country == "FI") {
                    native_country = "Suomi 🇫🇮";
                    issuer = "Digi- ja väestötietovirasto CSCA";
                }
                jeśli (country == "IE") {
                    native_country = "Éire/Ireland 🇮🇪";
                    issuer = "Department of Foreign Affairs CSCA";
                }
                jeśli (country == "PT") {
                    native_country = "Portugal 🇵🇹";
                    issuer = "Imprensa Nacional-Casa da Moeda CSCA";
                }
                jeśli (country == "GR") {
                    native_country = "Ελλάδα 🇬🇷";
                    issuer = "Hellenic Police Headquarters CSCA";
                }
                jeśli (country == "CZ") {
                    native_country = "Česká republika 🇨🇿";
                    issuer = "Státní tiskárna cenin CSCA";
                }
                jeśli (country == "HU") {
                    native_country = "Magyarország 🇭🇺";
                    issuer = "Belügyminisztérium CSCA";
                }
                jeśli (country == "SK") {
                    native_country = "Slovensko 🇸🇰";
                    issuer = "Ministerstvo vnútra Slovenskej republiky CSCA";
                }
                jeśli (country == "HR") {
                    native_country = "Hrvatska 🇭🇷";
                    issuer = "Ministarstvo unutarnjih poslova CSCA";
                }
                jeśli (country == "BG") {
                    native_country = "Bulgaria 🇧🇬";
                    issuer = "Ministry of Interior CSCA";
                }
                jeśli (country == "RO") {
                    native_country = "România 🇷🇴";
                    issuer = "Direcția Generală de Pașapoarte CSCA";
                }
                jeśli (country == "LT") {
                    native_country = "Lietuva 🇱🇹";
                    issuer = "Asmens dokumentų išrašymo centras CSCA";
                }
                jeśli (country == "LV") {
                    native_country = "Latvija 🇱🇻";
                    issuer = "Pilsonības un migrācijas lietu pārvalde CSCA";
                }
                jeśli (country == "EE") {
                    native_country = "Eesti 🇪🇪";
                    issuer = "Politsei- ja Piirivalveamet CSCA";
                }
                jeśli (country == "SI") {
                    native_country = "Slovenija 🇸🇮";
                    issuer = "Ministrstvo za notranje zadeve CSCA";
                }
                jeśli (country == "CY") {
                    native_country = "Cyprus 🇨🇾";
                    issuer = "Civil Registry and Migration Department CSCA";
                }
                jeśli (country == "MT") {
                    native_country = "Malta 🇲🇹";
                    issuer = "Identity Malta Agency CSCA";
                }
                jeśli (country == "LU") {
                    native_country = "Luxembourg 🇱🇺";
                    issuer = "Ministère des Affaires étrangères et européennes CSCA";
                }
                
                device_name = "EU ID Card / Passport (NFC RFID Chip - " + native_country + ")";
                cert_info = "Signature Certificate (European Union CSCA)";
                standard_info = "ICAO Doc 9303 / EAC";
                issuer_info = issuer;
            }
        }
        
        last_request_log = "Podpisano wyzwanie (" + challenge + ") dla " + device_name;
        
        // Zbudowanie słownika szczegółów weryfikacji sprzętowej
        niech details = slownik();
        details = ustaw(details, "device", device_name);
        details = ustaw(details, "cert", cert_info);
        details = ustaw(details, "standard", standard_info);
        details = ustaw(details, "serial", serial_num);
        details = ustaw(details, "issuer", issuer_info);
        details = ustaw(details, "holder", "JAKUB GODULA");
        details = ustaw(details, "pubkey", pub_key);
        details = ustaw(details, "signature", podpis_hex);
        details = ustaw(details, "pqcSalt", pqc_salt);
        details = ustaw(details, "alg", "ML-DSA-87 / Ed25519");
        
        niech tresc_dane = slownik();
        tresc_dane = ustaw(tresc_dane, "status", "success");
        tresc_dane = ustaw(tresc_dane, "details", details);
        
        niech odpowiedz = slownik();
        odpowiedz = ustaw(odpowiedz, "kod", 200);
        odpowiedz = ustaw(odpowiedz, "typ", "application/json; charset=utf-8");
        odpowiedz = ustaw(odpowiedz, "tresc", tresc_dane);
        
        zwróć odpowiedz;
    }
    
    // Błąd 404
    niech blad = slownik();
    blad = ustaw(blad, "kod", 404);
    blad = ustaw(blad, "typ", "application/json; charset=utf-8");
    
    niech blad_tresc = slownik();
    blad_tresc = ustaw(blad_tresc, "status", "error");
    blad_tresc = ustaw(blad_tresc, "message", "Endpoint nie odnaleziony");
    
    blad = ustaw(blad, "tresc", blad_tresc);
    zwróć blad;
}

niech URUCHOM_JAKO_DAEMON = fałsz;

// Parametry rejestracji organizacji
niech REG_CHALLENGE = "challenge-sui-organisation-registration-token-2026";
niech REG_KEY_TYPE = "eid";
niech REG_REGION = "EU";
niech REG_COUNTRY = "PL";

jeśli URUCHOM_JAKO_DAEMON {
    niech ip = adres("127.0.0.1");
    serwuj(ip, 9191, router_silicon);

    pisz("--------------------------------------------------");
    pisz("🌐 Symulator Silicon nasłuchuje na porcie 9191...");
    pisz("👉 Otwórz: https://127.0.0.1:9191/ w przeglądarce");
    pisz("--------------------------------------------------");
} w przeciwnym razie {
    pisz("--------------------------------------------------");
    pisz("⚡ Silicon: Uruchomienie w trybie bezpośredniej rejestracji...");
    pisz("--------------------------------------------------");

    niech zapytanie_dict = slownik();
    zapytanie_dict = ustaw(zapytanie_dict, "challenge", REG_CHALLENGE);
    zapytanie_dict = ustaw(zapytanie_dict, "hardwareKeyType", REG_KEY_TYPE);
    zapytanie_dict = ustaw(zapytanie_dict, "region", REG_REGION);
    zapytanie_dict = ustaw(zapytanie_dict, "country", REG_COUNTRY);

    niech zapytanie = koduj_json(zapytanie_dict);
    niech odpowiedz = router_silicon("/api/sign", zapytanie, "POST");
    niech kod = pobierz(odpowiedz, "kod");
    
    jeśli (kod == 200) {
        niech tresc = pobierz(odpowiedz, "tresc");
        niech details = pobierz(tresc, "details");
        
        pisz("✅ Rejestracja organizacji zakończona sukcesem!");
        pisz("📄 Dane uwierzytelniające (Hardware credentials):");
        pisz("  - Urządzenie (Device):", pobierz(details, "device"));
        pisz("  - Certyfikat (Cert):", pobierz(details, "cert"));
        pisz("  - Standard (Standard):", pobierz(details, "standard"));
        pisz("  - Numer seryjny (Serial):", pobierz(details, "serial"));
        pisz("  - Wydawca certyfikatu (Issuer):", pobierz(details, "issuer"));
        pisz("  - Właściciel (Holder):", pobierz(details, "holder"));
        pisz("  - Klucz publiczny simulatora (Pubkey):", pobierz(details, "pubkey"));
        pisz("  - Sygnatura wyzwania (Signature):", pobierz(details, "signature"));
        pisz("  - Post-Quantum Entropy Salt (pqcSalt):", pobierz(details, "pqcSalt"));
        pisz("  - Algorytm weryfikacji (Algorithm):", pobierz(details, "alg"));
        pisz("--------------------------------------------------");
    } w przeciwnym razie {
        pisz("❌ Błąd generowania danych rejestracyjnych:", odpowiedz);
    }
    zakoncz(0);
}
