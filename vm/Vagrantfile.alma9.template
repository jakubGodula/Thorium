# -*- mode: ruby -*-
# vi: set ft=ruby :
# Thorium XDR - AlmaLinux 9 VM Template
# Generated by Thorium VM Manager

Vagrant.configure("2") do |config|
  config.vm.box = "almalinux/9"
  config.vm.hostname = "thorium-{{VM_NAME}}"

  # Forward Thorium Agent API port to unique host port
  config.vm.network "forwarded_port", guest: 9090, host: {{HOST_PORT}}, host_ip: "127.0.0.1"
  # Forward SSH to custom port for multi-VM management
  config.vm.network "forwarded_port", guest: 22, host: {{SSH_PORT}}, id: "ssh", host_ip: "127.0.0.1"

  # Prywatna sieć dual-stack z IPv6
  config.vm.network "private_network",
    ip: "192.168.50.{{IP_SUFFIX}}",
    libvirt__network_name: "vagrant-private",
    libvirt__guest_ipv6: "yes",
    libvirt__ipv6_address: "fde4:8dba:82e1::{{IP_HOST_SUFFIX}}",
    libvirt__ipv6_prefix: "64"

  # Sync Mowa project source (rsync, excludes build artifacts)
  config.vm.synced_folder "{{PROJECT_DIR}}", "/opt/mowa-src",
    type: "rsync",
    rsync__exclude: [".git/", "target/", "node_modules/", ".vagrant/"]

  config.vm.provider "libvirt" do |libvirt|
    libvirt.driver = "kvm"
    libvirt.memory = 8192

    libvirt.cpus = 4
    libvirt.storage_pool_name = "default"
    libvirt.graphics_type = "none"
    libvirt.video_type = "vga"
  end

  config.vm.provision "shell",
    path: "{{PROJECT_DIR}}/thorium/vm/provision_alma9.sh",
    privileged: true,
    env: {
      "VM_NAME" => "{{VM_NAME}}",
      "SUI_CONTRACT" => "{{SUI_CONTRACT}}",
      "IPV6_ADDRESS" => "fde4:8dba:82e1::{{IP_GUEST_SUFFIX}}",
      "OWNER_NAME" => "{{OWNER_NAME}}",
      "MACHINE_TYPE" => "{{MACHINE_TYPE}}"
    }
end
